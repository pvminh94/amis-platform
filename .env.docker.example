# ==============================================================================
# .env cho docker compose — cp .env.docker.example .env rồi ĐỔI MỌI GIÁ TRỊ
# ==============================================================================
# File này được compose đọc. KHÔNG commit .env thật (đã nằm trong .gitignore
# và .dockerignore).

# --- Bắt buộc ---------------------------------------------------------------
# Mật khẩu PostgreSQL. Compose sẽ TỪ CHỐI start nếu để trống (dùng :? trong
# docker-compose.yml) — đó là chủ ý: một DB lương với mật khẩu mặc định là sự
# cố, không phải cấu hình.
POSTGRES_PASSWORD=doi-mat-khau-nay-ngay

# Bí mật ký JWT (HS256), tối thiểu 32 ký tự. Sinh bằng:
#   openssl rand -base64 48
# ĐỔI secret này = mọi access token đang dùng mất hiệu lực.
JWT_SECRET=doi-secret-nay-bang-openssl-rand-base64-48

# --- Tuỳ chọn ---------------------------------------------------------------
POSTGRES_DB=amis_platform
POSTGRES_USER=amis
APP_PORT=3000

# true = nạp dữ liệu mẫu ở lần start đầu (12 nhân viên, 360 ngày công, kỳ lương
# 09/2026, mật khẩu seed Amis@2026!). Để false cho hệ thống thật.
SEED_ON_START=false

# Origin được phép gọi API từ trình duyệt, phân cách bằng dấu phẩy.
# Để TRỐNG = không origin nào được phép (mặc định an toàn).
# KHÔNG dùng '*': nghĩa là bất kỳ trang nào cũng gọi được API bằng cookie của
# người dùng, tức là CSRF.
CORS_ORIGINS=
